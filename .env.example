# GitHub Token (for gh CLI and API access)
GITHUB_TOKEN=

# NPM Publishing
GHFS_PUBLISH_NPM=true
NPM_TOKEN=

# GitHub Packages
GHFS_PUBLISH_GITHUB_PACKAGES=false

# Container Images
GHFS_BUILD_CONTAINERS=false
DOCKER_USERNAME=
DOCKER_TOKEN=

# Attestations & Provenance
GHFS_CREATE_ATTESTATIONS=true
GHFS_NPM_PROVENANCE=true

# Deployments
GHFS_DEPLOY_DEMO=false
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Observability
GHFS_AUTO_REPORT=true
GHFS_NOTIFY_ON_RELEASE=true
